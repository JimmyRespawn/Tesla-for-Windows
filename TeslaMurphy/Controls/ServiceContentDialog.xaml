<ContentDialog
    x:Class="TeslaMurphy.Controls.ServiceContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Service" SecondaryButtonText="Close"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="300" Spacing="20">
            <TextBlock x:Name="VehicleLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top">
                        <FontIcon x:Name="StatusIcon" Glyph="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="22" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6">
                        <TextBlock Text="VEHICLE STATUS" FontSize="11" CharacterSpacing="100" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatusTitle" Text="Not in service" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDescription" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel x:Name="VisitDetails" Spacing="14" Visibility="Collapsed">
                <TextBlock Text="Visit details" FontSize="16" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0" Spacing="6">
                        <TextBlock Text="Visit number" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VisitNumber" Text="Not provided" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                        <TextBlock Text="Estimated completion" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="CompletionTime" Text="Not provided" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock x:Name="TimeNote" Text="Your local time" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <TextBlock Text="For appointments and service messages, use the Tesla app." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
