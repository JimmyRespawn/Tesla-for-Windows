<Window x:Class="TeslaMurphy.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tesla for Windows">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Frame x:Name="RootFrame" KeyboardAcceleratorPlacementMode="Hidden">
  <Frame.KeyboardAccelerators>
   <KeyboardAccelerator Key="F11" Invoked="Fullscreen_Invoked" />
  </Frame.KeyboardAccelerators>
 </Frame>
</Window>
